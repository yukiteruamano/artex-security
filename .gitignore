# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# single-binary build with the frontend embedded
/artex
# intermediates the one-click update leaves next to the executable
# (staged download / backup / failed version / upgrade marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key: generated at runtime next to the executable, never committed
/jwt.key

# local environment written by the Docker deployment (contains the database password)
.env

# event logs the scheduler writes while running or replaying (test artefacts)
*-events.csv

# bench harness artefacts (local only)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
# --- artex-security local operation: never committed (owner directive: test and scan results stay private) ---
work/
test-results/
scan-output/
evidence-local/
# runtime data a locally started demo app produces (recording-proxy traffic index,
# mitmproxy CA private key, ...), so it never lands in the public repository
/demo-data/
*.local.env
# Local-only artefact of the live model-comparison test: it has to live inside package
# agent, so it cannot go under work/, and it spends OPENROUTER_API_KEY and network quota.
# Ignored by exact path so the upstream test files stay tracked.
agent/d2_models_live_test.go

# API keys and secrets: never committed wherever they live
*.env
secrets.env

# secrets used for local configuration (for example the PostgreSQL password)
/.secrets/
# native binding cache produced when SWC_NATIVE_BINDING_CACHE is pointed inside the project
/.swc-cache/
# runtime logs redirected when artex runs in the foreground
/artex.out.log
/artex.err.log

# pnpm store when the package manager keeps it inside the project
/.pnpm-store/
# pi agent session scratch (task logs, per-session context)
/.pi/
